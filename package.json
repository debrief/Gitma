{
  "name": "tma-via-ml",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:golden": "vitest run golden",
    "schema:gen": "node packages/types/scripts/generate.ts",
    "schema:check": "node packages/types/scripts/check.ts",
    "tma-generate": "node packages/data/dist/cli-generate.js",
    "tma-convert": "node packages/data/dist/cli-convert.js",
    "tma-solve": "node packages/classical/dist/cli-solve.js",
    "tma-naive": "node packages/classical/dist/cli-naive.js",
    "tma-eval": "node packages/eval/dist/cli-eval.js",
    "tma-gate": "node packages/eval/dist/cli-gate.js",
    "tma-g0": "tsc -b && node packages/eval/dist/cli-g0.js",
    "tma-features": "node packages/features/dist/cli.js",
    "site:build": "pnpm --filter @tma/site build",
    "site:start": "pnpm --filter @tma/site start",
    "tma-train": "tsc -b && node packages/models/dist/cli-train.js",
    "tma-model-predict": "node packages/models/dist/cli-predict.js",
    "tma-g1": "tsc -b && node packages/models/dist/cli-g1.js",
    "tma-g2": "tsc -b && node packages/models/dist/cli-g2.js",
    "tma-scan": "tsc -b && node packages/models/dist/cli-scan.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
